PROJECT_NAME="Data_Analyzer"
API_V1_STR="/api"
SECRET_KEY="data-analyzer-secret-key-change-in-production-use-strong-entropy"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite for instant setup; switch to PostgreSQL easily)
DATABASE_URL="sqlite:///./data_analyzer.db"
# Example PostgreSQL connection string:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/data_analyzer"

# Upload and Security Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50
MAX_ROW_LIMIT=500000

# AI Provider Configuration (Optional - built-in deterministic analytics works 100% without keys)
AI_PROVIDER="auto" # Options: auto, gemini, openai, deterministic
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
